# Default real mode; opt into mock only for a visibly labeled keyword UI demo.
SEARCH_MODE=real
SEARCH_CATALOG_PATH=data/sample_catalog.json
SEARCH_CACHE_DIR=.cache/embeddings
SEARCH_HF_CACHE_DIR=.cache/huggingface
SEARCH_DIMENSIONS=2560
SEARCH_CANDIDATE_TOP_K=20
SEARCH_RESULT_TOP_N=5
# For reproducibility, set revision to a reviewed Hugging Face commit SHA.
# Resolved immutable commit is included in the vector cache key even for main.
SEARCH_EMBEDDING__REVISION=main
SEARCH_EMBEDDING__DEVICE=cpu
SEARCH_EMBEDDING__DTYPE=float32
SEARCH_EMBEDDING__BATCH_SIZE=1
SEARCH_EMBEDDING__MAX_LENGTH=512
SEARCH_RERANKER__REVISION=main
SEARCH_RERANKER__DEVICE=cpu
SEARCH_RERANKER__DTYPE=float32
SEARCH_RERANKER__BATCH_SIZE=1
SEARCH_RERANKER__MAX_LENGTH=512

# sample retains the original demo; opensearch requires SEARCH_MODE=real, dimensions=2560.
SEARCH_BACKEND=sample
# Metadata-only ingestion is the default; MEDIA_ROOT stores receipts/cache.
# Optional legacy downloads only: exact HTTPS domains, empty denies all.
MEDIA_ALLOWED_DOMAINS=["upload.wikimedia.org"]
MEDIA_ROOT=.media
MEDIA_MAX_BYTES=40000000
MEDIA_TOTAL_MAX_BYTES=160000000
MEDIA_TIMEOUT_SECONDS=60
MEDIA_RETRIES=1
MEDIA_MAX_REDIRECTS=3
# Configure an existing authorized cluster. No credentials are provided here.
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_INDEX=kids-media-v1
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_CA_CERTS=/absolute/path/to/trusted-root-ca.pem
OPENSEARCH_TIMEOUT_SECONDS=15
OPENSEARCH_ALLOW_HTTP_LOCAL=false
